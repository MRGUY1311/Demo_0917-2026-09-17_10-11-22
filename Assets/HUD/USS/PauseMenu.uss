:root {
}

.pause-button {
    width: 240px;
    height: 50px;
    font-size: 20px;
    margin-bottom: 12px;

    flex-direction: column;
    justify-content: center;
    align-items: center;
}
#PauseOverlay {
    width: 100%;
    height: 100%;

    flex-direction: column;
    justify-content: center;
    align-items: center;

    backdrop-filter: blur(12px);
    background-color: rgba(0, 0, 0, 0.3);
}
